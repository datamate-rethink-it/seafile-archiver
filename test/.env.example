# Testumgebung: nach .env kopieren und die leeren Secrets mit Zufallswerten füllen.
COMPOSE_PROJECT_NAME=sfarch
#COMPOSE_FILE=compose.yml:compose.s3.yml            # S3-Variante (MinIO)
#COMPOSE_FILE=compose.yml:compose.smb.yml           # Archivziel als SMB-Freigabe

SEAFILE_IMAGE=seafileltd/seafile-pro-mc:13.0-latest
SEAFILE_PORT=8088
SEAFILE_ADMIN_EMAIL=admin@example.com
SEAFILE_ADMIN_PASSWORD=admin-test-123

# Zufallswerte eintragen (openssl rand -hex 16 bzw. 32)
MARIADB_ROOT_PASSWORD=
REDIS_PASSWORD=
JWT_PRIVATE_KEY=
LLDAP_JWT_SECRET=
LLDAP_KEY_SEED=
LLDAP_ADMIN_PASSWORD=ldap-admin-123

# trägt seed.sh selbst ein
SEAFILE_ADMIN_TOKEN=
