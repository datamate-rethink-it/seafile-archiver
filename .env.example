# ---------------------------------------------------------------------------
# seafile-archiver: alle Einstellungen
# ---------------------------------------------------------------------------

# --- Seafile-Datenbank (gleiche Namen wie beim Seafile-Container) ---------
SEAFILE_MYSQL_DB_HOST=mariadb
SEAFILE_MYSQL_DB_PORT=3306
SEAFILE_MYSQL_DB_USER=archiver            # empfohlen: eigener User mit nur SELECT-Rechten
SEAFILE_MYSQL_DB_PASSWORD=
#SEAFILE_MYSQL_DB_CCNET_DB_NAME=ccnet_db
#SEAFILE_MYSQL_DB_SEAFILE_DB_NAME=seafile_db
#SEAFILE_MYSQL_DB_SEAHUB_DB_NAME=seahub_db
#LDAP_PROVIDER=ldap                       # wie LDAP_PROVIDER in seahub_settings.py

# --- Storage -----------------------------------------------------------------
# Disk: nichts zu tun, gelesen wird aus dem eingebundenen Seafile-Volume.
# S3 (Seafile 13 per Umgebung konfiguriert): dieselben Variablen wie beim
# Seafile-Container übernehmen, sie werden direkt von seafobj gelesen.
#SEAF_SERVER_STORAGE_TYPE=s3
#S3_COMMIT_BUCKET=
#S3_FS_BUCKET=
#S3_BLOCK_BUCKET=
#S3_KEY_ID=
#S3_SECRET_KEY=
#S3_HOST=
#S3_AWS_REGION=
#S3_USE_HTTPS=true
#S3_USE_V4_SIGNATURE=true
#S3_PATH_STYLE_REQUEST=false
#SEAFILE_DATA_DIR=/shared/seafile/seafile-data
#SEAFILE_CONF_DIR=/shared/seafile/conf

# --- Verhalten --------------------------------------------------------------
DRY_RUN=true                              # erst auf false stellen, wenn die Probeläufe passen
DELETE_AFTER_DAYS=                        # leer = nie löschen; 30 = User + Bibliotheken 30 Tage nach Export löschen
BLOCK_DELETE_IF_SHARED=true               # geteilte Bibliotheken blockieren die Löschung, bis übertragen oder Freigabe entfernt
MAX_USERS_PER_RUN=5                       # mehr neu deaktivierte User → Abbruch ohne jede Aktion
MAX_DELETIONS_PER_RUN=10                  # mehr fällige Löschungen → Rest in den folgenden Läufen
EXCLUDE_USERS=                            # kommagetrennt: LDAP-UID, Kontakt-Mail oder Seafile-ID
ONLY_LDAP_USERS=true                      # true: nur User mit LDAP-Konto; false: alle deaktivierten User (Seafile ohne LDAP)

# --- Archiv -----------------------------------------------------------------
#ARCHIVE_DIR=/archiv
#STATE_DIR=/data
ARCHIVE_UID=                              # Besitzer der exportierten Dateien (Standard: root)
ARCHIVE_GID=
WRITE_CHECKSUMS=true                      # _SHA256SUMS pro User-Ordner
#FREE_SPACE_FACTOR=1.1                    # benötigter Platz = Bibliotheksgröße × Faktor

# --- Seafile-Admin-API (nur für DELETE_AFTER_DAYS nötig) --------------------
SEAFILE_URL=http://seafile
SEAFILE_API_TOKEN=

# --- Überwachung und Bericht ------------------------------------------------
HEALTHCHECK_URL=                          # z.B. https://hc-ping.com/<uuid>
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls                    # starttls | ssl | none
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
MAIL_TO=                                  # kommagetrennt

# --- Zeitplan ---------------------------------------------------------------
SCHEDULE=01:30                            # kommagetrennte Uhrzeiten; leer = extern starten (Ofelia)
RUN_ON_START=false
TZ=Europe/Berlin
#LOG_LEVEL=INFO
#PROGRESS_SECONDS=60                      # Fortschritt langer Exporte im Log
